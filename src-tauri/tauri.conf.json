{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent SMC",
  "version": "1.0.0",
  "identifier": "com.local.agent-smc",
  "build": {
    "beforeDevCommand": "npm run build:sidecar && npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build && npm run build:sidecar",
    "frontendDist": "../public/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Agent SMC",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg"],
    "resources": ["sidecar-node"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    }
  }
}